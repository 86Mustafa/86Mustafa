# انسخ هذا الملف إلى .env وعدّل القيم حسب الحاجة. كل القيم اختيارية.

# المنفذ وعنوان الاستماع (0.0.0.0 = يمكن الوصول من أجهزة الشبكة المحلية)
PORT=3001
HOST=0.0.0.0

# مجلد البيانات (قاعدة البيانات والصور المرفوعة)
DATA_DIR=data

# حساب المدير الأول (يُنشأ فقط عند أول تشغيل إذا لم يوجد أي مستخدم)
# إذا تُركت كلمة المرور فارغة تُولَّد عشوائياً وتُطبع في نافذة الخادم
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# سر توقيع الجلسات. إذا تُرك فارغاً يُولَّد ويُحفظ في data/.jwt-secret
JWT_SECRET=

# مدة الجلسة بالساعات
SESSION_HOURS=12

# اجعلها true فقط عند التشغيل خلف HTTPS
COOKIE_SECURE=false

# اجعلها true إذا كان الخادم خلف Nginx أو بروكسي عكسي
TRUST_PROXY=false

# المنطقة الزمنية لتواريخ الطلبات
APP_TIMEZONE=Asia/Baghdad
